{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Dark Matter Code",
  "author": "Amirali Beigi",
  "themes": [
    {
      "name": "Dark Matter Code Black",
      "appearance": "dark",
      "style": {
        "accents": ["#b496e7", "#a874ff", "#61afef", "#56b6c2", "#98c379", "#e06c75", "#e5c07b"],
        "background": "#000000",
        "border": "#282828",
        "border.focused": "#b496e7",
        "border.selected": "#b496e7",
        "border.variant": "#181818",
        "editor.background": "#000000",
        "editor.foreground": "#d4d4d4",
        "editor.gutter.background": "#000000",
        "editor.line_number": "#858585",
        "editor.active_line_number": "#c6c6c6",
        "editor.active_line.background": "#080808",
        "editor.highlighted_line.background": "#080808",
        "editor.indent_guide": "#282828",
        "editor.indent_guide_active": "#707070",
        "editor.invisible": "#e3e4e229",
        "element.background": "#0a0a0a",
        "element.hover": "#181818",
        "element.selected": "#b496e73c",
        "elevated_surface.background": "#080808",
        "icon": "#bebebe",
        "icon.accent": "#b496e7",
        "icon.disabled": "#555555",
        "icon.muted": "#808080",
        "panel.background": "#000000",
        "pane_group.border": "#282828",
        "scrollbar.thumb.background": "#282828",
        "scrollbar.thumb.hover_background": "#404040",
        "scrollbar.track.background": "#000000",
        "surface.background": "#080808",
        "tab.active_background": "#080808",
        "tab.inactive_background": "#000000",
        "tab_bar.background": "#000000",
        "text": "#bebebe",
        "text.accent": "#a874ff",
        "text.disabled": "#666666",
        "text.muted": "#858585",
        "text.placeholder": "#666666",
        "title_bar.background": "#000000",
        "title_bar.inactive_background": "#050505",
        "toolbar.background": "#000000",
        "status_bar.background": "#a874ff",
        "terminal.background": "#000000",
        "terminal.foreground": "#cccccc",
        "terminal.bright_foreground": "#ffffff",
        "terminal.ansi.black": "#000000",
        "terminal.ansi.bright_black": "#666666",
        "terminal.ansi.red": "#e06c75",
        "terminal.ansi.bright_red": "#ff7b86",
        "terminal.ansi.green": "#98c379",
        "terminal.ansi.bright_green": "#b5e890",
        "terminal.ansi.yellow": "#e5c07b",
        "terminal.ansi.bright_yellow": "#ffdf9b",
        "terminal.ansi.blue": "#61afef",
        "terminal.ansi.bright_blue": "#85c1ff",
        "terminal.ansi.magenta": "#c678dd",
        "terminal.ansi.bright_magenta": "#e39af5",
        "terminal.ansi.cyan": "#56b6c2",
        "terminal.ansi.bright_cyan": "#7bdde8",
        "terminal.ansi.white": "#d4d4d4",
        "terminal.ansi.bright_white": "#ffffff",
        "syntax": {
          "attribute": {"color": "#d19a66"},
          "boolean": {"color": "#c678dd"},
          "comment": {"color": "#7f848e", "font_style": "italic"},
          "comment.doc": {"color": "#7f848e", "font_style": "italic"},
          "constant": {"color": "#d19a66"},
          "constructor": {"color": "#e5c07b"},
          "embedded": {"color": "#d4d4d4"},
          "emphasis": {"color": "#e06c75", "font_style": "italic"},
          "function": {"color": "#61afef"},
          "keyword": {"color": "#c678dd"},
          "label": {"color": "#e06c75"},
          "link_text": {"color": "#61afef"},
          "number": {"color": "#d19a66"},
          "operator": {"color": "#56b6c2"},
          "property": {"color": "#e06c75"},
          "punctuation": {"color": "#d4d4d4"},
          "string": {"color": "#98c379"},
          "string.escape": {"color": "#56b6c2"},
          "tag": {"color": "#e06c75"},
          "text.literal": {"color": "#98c379"},
          "type": {"color": "#56b6c2"},
          "variable": {"color": "#e06c75"},
          "variant": {"color": "#e5c07b"}
        }
      }
    }
  ]
}
